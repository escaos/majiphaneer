---
import { type Locale, type PageId, SITE_NAME, t } from '@majiphaneer/data';
import ThemeToggle from '../islands/ThemeToggle.tsx';
import { NAV_KEYS } from '../lib/nav.ts';
import { PAGE_IDS, pagePath } from '../lib/paths.ts';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  page: PageId;
  overlay?: boolean;
}

const { locale, page, overlay = false } = Astro.props;

const items = PAGE_IDS.map((id) => ({
  id,
  href: pagePath(locale, id),
  label: t(locale, NAV_KEYS[id]),
}));
---

<header
  class:list={[
    overlay
      ? 'absolute inset-x-0 top-0 z-40 text-[#ebeae5]'
      : 'border-b border-border bg-bg',
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a
      href={pagePath(locale, 'home')}
      class="font-display text-[2rem] uppercase tracking-widest text-inherit"
    >
      {SITE_NAME}
    </a>
    <div class="flex items-center gap-3">
      <LanguageSwitcher locale={locale} page={page} tone={overlay ? 'light' : 'default'} />
      <ThemeToggle
        client:idle
        label={t(locale, 'theme.toggle')}
        tone={overlay ? 'light' : 'default'}
      />
      <details class="relative">
        <summary
          aria-label={t(locale, 'nav.menu')}
          class:list={[
            'menu-toggle flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full transition-colors [&::-webkit-details-marker]:hidden',
            overlay
              ? 'text-[#ebeae5]/85 hover:bg-[#ebeae5]/15 hover:text-[#ebeae5]'
              : 'text-muted hover:bg-alt hover:text-ink',
          ]}
        >
          <Icon name="menu" size={20} />
        </summary>
        <nav
          aria-label={t(locale, 'nav.menu')}
          class="menu-panel absolute right-0 top-full z-50 mt-3 w-72 overflow-hidden rounded-2xl border border-[#3a3c36] bg-[#23251f] py-2 text-[#ebeae5] shadow-2xl"
        >
          <ul>
            {
              items.map((item, index) => (
                <li class="border-b border-[#ebeae5]/5 last:border-b-0">
                  <a
                    href={item.href}
                    aria-current={item.id === page ? 'page' : undefined}
                    class:list={[
                      'group flex items-baseline justify-between gap-4 px-6 py-3.5 font-display text-sm uppercase tracking-widest transition-all hover:bg-[#ebeae5]/5 hover:pl-7',
                      item.id === page ? 'text-accent' : 'text-[#ebeae5]/85 hover:text-[#ebeae5]',
                    ]}
                  >
                    {item.label}
                    <span class="font-sans text-[10px] font-semibold tracking-[0.3em] text-[#ebeae5]/35 transition-colors group-hover:text-accent">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
