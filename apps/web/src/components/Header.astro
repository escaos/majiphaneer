---
import { type Locale, type PageId, SITE_NAME, t } from '@majiphaneer/data';
import ThemeToggle from '../islands/ThemeToggle.tsx';
import { NAV_KEYS } from '../lib/nav.ts';
import { PAGE_IDS, pagePath } from '../lib/paths.ts';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;

const items = PAGE_IDS.map((id) => ({
  id,
  href: pagePath(locale, id),
  label: t(locale, NAV_KEYS[id]),
}));
---

<header class="border-b border-border bg-bg">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href={pagePath(locale, 'home')} class="font-display text-base uppercase tracking-widest">
      {SITE_NAME}
    </a>
    <div class="flex items-center gap-3">
      <LanguageSwitcher locale={locale} page={page} />
      <ThemeToggle client:idle label={t(locale, 'theme.toggle')} />
      <details class="relative">
        <summary
          aria-label={t(locale, 'nav.menu')}
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full text-muted transition-colors hover:bg-alt hover:text-ink [&::-webkit-details-marker]:hidden"
        >
          <Icon name="menu" size={20} />
        </summary>
        <nav
          aria-label={t(locale, 'nav.menu')}
          class="absolute right-0 top-full z-50 mt-2 w-60 rounded-2xl border border-border bg-bg p-2 shadow-lg"
        >
          <ul>
            {
              items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.id === page ? 'page' : undefined}
                    class:list={[
                      'block rounded-xl px-4 py-2.5 text-sm transition-colors hover:bg-surface',
                      item.id === page ? 'bg-alt font-semibold text-ink' : 'text-muted',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
