---
import { getContent, type Locale, SITE_NAME, t } from '@majiphaneer/data';
import type { IconName } from '../lib/icons.ts';
import { NAV_KEYS } from '../lib/nav.ts';
import { PAGE_IDS, pagePath } from '../lib/paths.ts';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { contact } = getContent(locale);

const sections = PAGE_IDS.map((id) => ({
  href: pagePath(locale, id),
  label: t(locale, NAV_KEYS[id]),
}));

const actions = [
  { href: `${pagePath(locale, 'contact')}#invitations`, label: t(locale, 'action.invite') },
  { href: pagePath(locale, 'books'), label: t(locale, 'action.book') },
  { href: pagePath(locale, 'contravia'), label: t(locale, 'action.podcast') },
];

const SOCIAL_ICONS: Record<string, IconName> = {
  instagram: 'instagram',
  facebook: 'facebook',
  tiktok: 'tiktok',
  spotify: 'spotify',
};

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-alt">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-3">
    <nav aria-label={t(locale, 'footer.sections')}>
      <h2 class="text-sm tracking-widest">{t(locale, 'footer.sections')}</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        {
          sections.map((section) => (
            <li>
              <a href={section.href} class="text-muted transition-colors hover:text-ink">
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="order-first flex flex-col items-center gap-4 text-center sm:order-none">
      <svg viewBox="0 0 64 64" width="52" height="52" aria-hidden="true">
        <rect width="64" height="64" rx="14" class="fill-accent"></rect>
        <path
          d="M16 46V18l16 19 16-19v28"
          fill="none"
          class="stroke-bg"
          stroke-width="5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <p class="font-display text-sm uppercase tracking-widest">{SITE_NAME}</p>
      <p class="font-serif text-sm italic text-muted">{t(locale, 'footer.tagline')}</p>
      <ul class="flex items-center gap-4">
        {
          contact.socials.map((social) => (
            <li>
              {social.url !== '' ? (
                <a
                  href={social.url}
                  rel="me noopener"
                  aria-label={social.label}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface hover:text-ink"
                >
                  <Icon name={SOCIAL_ICONS[social.id] ?? 'globe'} size={20} />
                </a>
              ) : (
                <span
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full text-muted opacity-40"
                  title={social.label}
                >
                  <Icon name={SOCIAL_ICONS[social.id] ?? 'globe'} size={20} />
                  <span class="sr-only">{social.label}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label={t(locale, 'footer.takeAction')} class="sm:justify-self-end sm:text-right">
      <h2 class="text-sm tracking-widest">{t(locale, 'footer.takeAction')}</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        {
          actions.map((action) => (
            <li>
              <a href={action.href} class="text-muted transition-colors hover:text-ink">
                {action.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-5 text-center text-sm text-muted">
      © {year}
      {SITE_NAME}. {t(locale, 'footer.rights')}
    </p>
  </div>
</footer>
