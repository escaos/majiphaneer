---
import { getContent, LOCALES, type Locale, type PageId, SITE_NAME, t } from '@majiphaneer/data';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { webSiteJsonLd } from '../lib/jsonld.ts';
import { ogImageFor } from '../lib/og.ts';
import { pagePath } from '../lib/paths.ts';
import { THEME_KEY } from '../lib/theme.ts';
import '../styles/global.css';

interface Props {
  locale: Locale;
  page: PageId;
  noindex?: boolean;
  ogType?: 'website' | 'book';
  jsonLd?: Record<string, unknown>[];
  /** Float a transparent light-toned header over the page's hero image. */
  heroOverlay?: boolean;
}

const {
  locale,
  page,
  noindex = false,
  ogType = 'website',
  jsonLd = [],
  heroOverlay = false,
} = Astro.props;

const content = getContent(locale);
const meta = content.meta[page];

// Astro.site comes from SITE_URL; canonicals use it so preview builds can't
// claim the production URL. No trailing slash (root URL is the bare origin).
const origin = (Astro.site ?? new URL('http://localhost:4321')).origin;
const toAbsolute = (path: string) => (path === '/' ? origin : `${origin}${path}`);
const canonical = toAbsolute(pagePath(locale, page));

const alternates = LOCALES.map((l) => ({ hreflang: l, href: toAbsolute(pagePath(l, page)) }));
const xDefault = toAbsolute(pagePath('es', page));

const OG_LOCALES: Record<Locale, string> = { es: 'es_ES', en: 'en_US', fr: 'fr_FR', de: 'de_DE' };

// Per-page 1200×630 share image, generated at build from the page's photo.
const ogImage = await ogImageFor(page);
const ogImageUrl = `${origin}${ogImage.path}`;
const ogImageAlt = ogImage.alt[locale];

// Stamps data-theme on <html> before first paint. The brand palette (light)
// is ALWAYS the first-visit default — dark is explicit opt-in via the toggle
// only, so the design-system colors are what every new visitor sees.
// data-js gates the scroll-reveal hidden state: no JS → nothing ever hides.
const themeScript = `(()=>{var d=document.documentElement;d.dataset.js='1';try{var t=localStorage.getItem('${THEME_KEY}');d.dataset.theme=t==='dark'?'dark':'light'}catch(e){d.dataset.theme='light'}})()`;

// Every structured-data block gets the page photo unless it declares its own,
// so Person/Book/PodcastSeries rich results can show an image.
const jsonLdBlocks = [webSiteJsonLd(origin, locale), ...jsonLd].map((block) =>
  'image' in block ? block : { ...block, image: ogImageUrl },
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <script is:inline set:html={themeScript} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/archivo-expanded-black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/montserrat-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#f8f6f2" />
    {jsonLdBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="bg-bg text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2"
    >
      {t(locale, 'skip.content')}
    </a>
    <Header locale={locale} page={page} overlay={heroOverlay} />
    <main id="main" class={heroOverlay ? '' : 'pt-28'}>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // Scroll-reveal: flips .reveal/.reveal-clip elements visible as they
      // enter the viewport. Reduced-motion (or no observer) shows everything.
      const els = document.querySelectorAll('.reveal, .reveal-clip');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -48px' },
        );
        for (const el of els) io.observe(el);
      } else {
        for (const el of els) el.classList.add('is-visible');
      }

      // Glass navigation: frost the fixed header once the page scrolls.
      const header = document.querySelector('.site-header');
      if (header) {
        const onHeaderScroll = () => header.classList.toggle('is-glass', window.scrollY > 24);
        onHeaderScroll();
        addEventListener('scroll', onHeaderScroll, { passive: true });
      }

      // Slow parallax: elements tagged data-parallax drift against scroll,
      // proportional to their distance from the viewport center.
      const layers = Array.from(document.querySelectorAll('[data-parallax]'));
      if (layers.length > 0 && !reduced) {
        let ticking = false;
        const drift = () => {
          ticking = false;
          const mid = innerHeight / 2;
          for (const el of layers) {
            const r = el.getBoundingClientRect();
            const speed = Number.parseFloat((el as HTMLElement).dataset.parallax || '0.1');
            const y = (r.top + r.height / 2 - mid) * -speed;
            (el as HTMLElement).style.transform = `translate3d(0, ${y.toFixed(1)}px, 0)`;
          }
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(drift);
          }
        };
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
