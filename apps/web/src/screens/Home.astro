---
import { Image } from 'astro:assets';
import { getContent, type Locale, SITE_NAME, t } from '@majiphaneer/data';
import heroWide from '../assets/photos/LK_01734-wide.jpg';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { personJsonLd } from '../lib/jsonld.ts';
import { pagePath } from '../lib/paths.ts';
import { photoById } from '../lib/photos.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, about, contravia, books, music, gallery, contact } = getContent(locale);
// Canvas-extended (zoomed-out) derivative of the profile portrait, built for
// the wide hero crop; alt text comes from the source photo's record.
const heroAlt = photoById('profile').alt;
const origin = (Astro.site ?? new URL('http://localhost:4321')).origin;

// Editorial spreads: photo + oversized title + serif deck, alternating sides.
const sections = [
  {
    href: pagePath(locale, 'about'),
    photo: photoById('floor-thoughtful'),
    title: about.title,
    phrase: t(locale, 'cta.story'),
    focus: '50% 25%',
  },
  {
    href: pagePath(locale, 'contravia'),
    photo: photoById('denim-laughing'),
    title: contravia.title,
    phrase: contravia.tagline,
    focus: '50% 25%',
  },
  {
    href: pagePath(locale, 'books'),
    photo: photoById('black-ruffles'),
    title: books.title,
    phrase: books.book.tagline,
    focus: '50% 12%',
  },
  {
    href: pagePath(locale, 'music'),
    photo: photoById('denim-table'),
    title: music.title,
    phrase: music.intro[0] ?? t(locale, 'music.soon'),
    focus: '50% 25%',
  },
  {
    href: pagePath(locale, 'gallery'),
    photo: photoById('suit-standing'),
    title: gallery.title,
    phrase: gallery.intro,
    focus: '50% 25%',
  },
  {
    href: pagePath(locale, 'contact'),
    photo: photoById('stool-seated'),
    title: contact.invitationsTitle,
    phrase: contact.invitationsTagline,
    focus: '50% 25%',
  },
];
---

<Base locale={locale} page="home" heroOverlay jsonLd={[personJsonLd(origin, locale)]}>
  <section class="relative h-[100svh] min-h-[560px] overflow-hidden">
    <Image
      src={heroWide}
      alt={heroAlt[locale]}
      widths={[800, 1400, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img absolute inset-0 h-full w-full object-cover object-[50%_20%]"
      data-parallax="0.08"
    />
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-[#20221f]/45 to-transparent"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-[22%] backdrop-blur-md [mask-image:linear-gradient(to_right,black_55%,transparent)]"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-[22%] backdrop-blur-md [mask-image:linear-gradient(to_left,black_55%,transparent)]"
    >
    </div>
    <a
      href="#masthead"
      class="scroll-cue absolute inset-x-0 bottom-8 z-10 mx-auto flex w-max flex-col items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.35em] text-[#ebeae5]/90 transition-colors hover:text-[#ebeae5]"
    >
      {t(locale, 'cta.more')}
      <Icon name="chevronDown" size={30} />
    </a>
  </section>

  <section id="masthead" class="mx-auto max-w-[90rem] scroll-mt-24 px-5 pb-6 pt-24 md:px-10">
    <p class="reveal text-xs font-semibold uppercase tracking-[0.4em] text-secondary">
      {t(locale, 'footer.tagline')}
    </p>
    <h1
      class="reveal mt-6 font-display text-[clamp(3rem,11vw,9.5rem)] leading-[0.92] tracking-tight"
    >
      {SITE_NAME}
    </h1>
    <div class="mt-10 grid gap-10 md:grid-cols-12">
      <p
        class="reveal reveal-d1 font-serif text-2xl italic leading-relaxed text-muted md:col-span-6 md:col-start-6"
      >
        {home.heroIntro[0]}
      </p>
    </div>
    <div class="reveal reveal-d2 mt-10 flex flex-wrap gap-10 md:justify-end">
      <a href={pagePath(locale, 'books')} class="link-editorial text-ink">
        {t(locale, 'cta.book')}
        <Icon name="arrowRight" size={14} />
      </a>
      <a href={pagePath(locale, 'contravia')} class="link-editorial text-ink">
        {t(locale, 'cta.podcast')}
        <Icon name="arrowRight" size={14} />
      </a>
    </div>
  </section>

  {
    home.welcomeVideoUrl !== '' && (
      <section class="mx-auto max-w-[90rem] px-5 pt-16 md:px-10">
        <div class="aspect-video w-full overflow-hidden rounded-none">
          <iframe
            src={home.welcomeVideoUrl}
            title={home.welcomeTitle}
            loading="lazy"
            allowfullscreen
            class="h-full w-full"
          />
        </div>
      </section>
    )
  }

  <div id="sections" class="mx-auto max-w-[90rem] scroll-mt-24 px-5 md:px-10">
    {
      sections.map((section, index) => (
        <a
          href={section.href}
          class="group grid items-center gap-8 py-16 md:grid-cols-12 md:gap-0 md:py-24"
        >
          <div
            class:list={[
              'reveal-clip overflow-hidden',
              index % 2 === 0 ? 'md:col-span-7 md:col-start-1' : 'md:col-span-7 md:col-start-6',
            ]}
          >
            <Image
              src={section.photo.image}
              alt={section.photo.alt[locale]}
              widths={[600, 900, 1400]}
              sizes="(min-width: 768px) 58vw, 100vw"
              loading="lazy"
              class="aspect-[4/3] w-full scale-110 object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.16]"
              style={`object-position: ${section.focus}`}
              data-parallax="0.05"
            />
          </div>
          <div
            class:list={[
              'reveal md:relative md:z-10',
              index % 2 === 0
                ? 'md:col-span-5 md:col-start-8 md:-ml-16 lg:-ml-24'
                : 'md:col-span-5 md:col-start-1 md:row-start-1 md:-mr-16 md:text-right lg:-mr-24',
            ]}
          >
            <p class="text-xs font-semibold uppercase tracking-[0.4em] text-secondary">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h2 class="mt-4 font-display text-[clamp(2.4rem,6vw,5rem)] leading-[0.95]">
              {section.title}
            </h2>
            <p
              class:list={[
                'mt-6 max-w-md font-serif text-xl italic leading-relaxed text-muted',
                index % 2 === 1 ? 'md:ml-auto' : '',
              ]}
            >
              {section.phrase}
            </p>
            <span class="link-editorial mt-8 text-ink">
              {t(locale, 'cta.explore')}
              <Icon name="arrowRight" size={14} />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</Base>
