---
import { Image } from 'astro:assets';
import { getContent, type Locale, t } from '@majiphaneer/data';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { personJsonLd } from '../lib/jsonld.ts';
import { pagePath } from '../lib/paths.ts';
import { photoById } from '../lib/photos.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, about, contravia, books, music, gallery, contact } = getContent(locale);
const hero = photoById('beige-smile');
const origin = (Astro.site ?? new URL('http://localhost:4321')).origin;

// Candace-style photo sections: image + short phrase, each opens a side page.
const sections = [
  {
    href: pagePath(locale, 'about'),
    photo: photoById('floor-thoughtful'),
    title: about.title,
    phrase: t(locale, 'cta.story'),
  },
  {
    href: pagePath(locale, 'contravia'),
    photo: photoById('denim-laughing'),
    title: contravia.title,
    phrase: contravia.tagline,
  },
  {
    href: pagePath(locale, 'books'),
    photo: photoById('profile'),
    title: books.title,
    phrase: books.book.tagline,
  },
  {
    href: pagePath(locale, 'music'),
    photo: photoById('denim-table'),
    title: music.title,
    phrase: music.intro[0] ?? t(locale, 'music.soon'),
  },
  {
    href: pagePath(locale, 'gallery'),
    photo: photoById('suit-standing'),
    title: gallery.title,
    phrase: gallery.intro,
  },
  {
    href: pagePath(locale, 'contact'),
    photo: photoById('suit-seated'),
    title: contact.invitationsTitle,
    phrase: contact.invitationsTagline,
  },
];
---

<Base locale={locale} page="home" jsonLd={[personJsonLd(origin, locale)]}>
  <section class="relative h-[58vh] min-h-[420px] overflow-hidden">
    <Image
      src={hero.image}
      alt={hero.alt[locale]}
      widths={[800, 1400, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img absolute inset-0 h-full w-full object-cover object-[50%_30%]"
    />
    <div class="absolute inset-0 flex items-end">
      <div class="mx-auto w-full max-w-6xl px-4 pb-10 md:pb-16">
        <div
          class="rounded-2xl bg-[#f2e7d8]/80 p-6 text-[#3d3630] md:ml-auto md:max-w-lg md:bg-transparent md:p-0"
        >
          <h1
            class="reveal font-hero text-[clamp(0.95rem,2.5vw,1.9rem)] font-bold normal-case leading-[1.2] tracking-normal"
          >
            {home.heroIntro[0]}
          </h1>
          <div class="reveal reveal-d1 mt-6 flex flex-wrap gap-3">
            <a
              href={pagePath(locale, 'books')}
              class="inline-flex items-center gap-2 rounded-full bg-[#3d3630] px-6 py-2.5 text-sm font-semibold text-[#f4ece1] transition-opacity hover:opacity-90"
            >
              {t(locale, 'cta.book')}
            </a>
            <a
              href={pagePath(locale, 'contravia')}
              class="inline-flex items-center gap-2 rounded-full border border-[#3d3630]/40 px-6 py-2.5 text-sm font-semibold transition-colors hover:bg-[#3d3630]/10"
            >
              {t(locale, 'cta.podcast')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="reveal mx-auto max-w-3xl px-4 pt-20 text-center">
    <h2 class="text-2xl">{home.welcomeTitle}</h2>
    <p class="mt-5 font-serif text-xl italic leading-relaxed text-muted">{home.welcome[0]}</p>
  </section>

  <div class="mx-auto grid max-w-6xl gap-8 px-4 pt-20">
    {
      sections.map((section, index) => (
        <a href={section.href} class="reveal group grid items-center gap-8 md:grid-cols-2">
          <div
            class:list={[
              'overflow-hidden rounded-2xl',
              index % 2 === 1 ? 'md:order-2' : '',
            ]}
          >
            <Image
              src={section.photo.image}
              alt={section.photo.alt[locale]}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              class="aspect-[16/10] w-full object-cover object-[50%_25%] transition-transform duration-700 ease-out group-hover:scale-105"
            />
          </div>
          <div
            class:list={[
              index % 2 === 1 ? 'md:order-1 md:justify-self-end md:text-right' : '',
            ]}
          >
            <p class="text-xs font-semibold uppercase tracking-[0.35em] text-secondary">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h2 class="mt-3 text-3xl md:text-4xl">{section.title}</h2>
            <p class="mt-4 max-w-md font-serif text-lg italic text-muted">{section.phrase}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest transition-all group-hover:gap-4">
              {t(locale, 'cta.explore')}
              <Icon name="arrowRight" size={16} />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</Base>
