---
import { Image } from 'astro:assets';
import { getContent, type Locale, t } from '@majiphaneer/data';
import Base from '../layouts/Base.astro';
import { personJsonLd } from '../lib/jsonld.ts';
import { pagePath } from '../lib/paths.ts';
import { photoById } from '../lib/photos.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, about, contravia, books, music, gallery, contact } = getContent(locale);
const hero = photoById('denim-laughing');
const origin = (Astro.site ?? new URL('http://localhost:4321')).origin;

// sarahjakesroberts.com-style home: clean photo hero, statement band, video
// (when provided), then full-bleed photo tiles that open the side pages.
const sections = [
  { href: pagePath(locale, 'about'), photo: photoById('floor-thoughtful'), title: about.title },
  {
    href: pagePath(locale, 'contravia'),
    photo: photoById('suit-seated'),
    title: contravia.title,
  },
  { href: pagePath(locale, 'books'), photo: photoById('profile'), title: books.title },
  { href: pagePath(locale, 'music'), photo: photoById('denim-table'), title: music.title },
  { href: pagePath(locale, 'gallery'), photo: photoById('suit-standing'), title: gallery.title },
  {
    href: pagePath(locale, 'contact'),
    photo: photoById('stool-seated'),
    title: contact.invitationsTitle,
  },
];
---

<Base locale={locale} page="home" jsonLd={[personJsonLd(origin, locale)]}>
  <section class="relative h-[58vh] min-h-[420px] overflow-hidden">
    <Image
      src={hero.image}
      alt={hero.alt[locale]}
      widths={[800, 1400, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img absolute inset-0 h-full w-full object-cover object-[50%_18%]"
    />
    <div class="absolute inset-0 flex items-end md:items-center">
      <div class="mx-auto w-full max-w-6xl px-4 pb-10 md:pb-0">
        <div
          class="rounded-2xl bg-[#20221f]/60 p-6 text-[#ebeae5] md:max-w-md md:bg-transparent md:p-0"
        >
          <h1
            class="reveal font-hero text-[clamp(0.95rem,2.5vw,1.9rem)] font-bold normal-case leading-[1.2] tracking-normal"
          >
            {home.heroIntro[0]}
          </h1>
          <div class="reveal reveal-d1 mt-6 flex flex-wrap gap-3">
            <a
              href={pagePath(locale, 'books')}
              class="inline-flex items-center gap-2 rounded-full bg-[#ebeae5]/95 px-6 py-2.5 text-sm font-semibold text-[#2f312c] transition-opacity hover:opacity-90"
            >
              {t(locale, 'cta.book')}
            </a>
            <a
              href={pagePath(locale, 'contravia')}
              class="inline-flex items-center gap-2 rounded-full border border-[#ebeae5]/60 px-6 py-2.5 text-sm font-semibold transition-colors hover:bg-[#ebeae5]/15"
            >
              {t(locale, 'cta.podcast')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    home.welcomeVideoUrl !== '' && (
      <section class="bg-bg">
        <div class="mx-auto aspect-video w-full max-w-5xl">
          <iframe
            src={home.welcomeVideoUrl}
            title={home.welcomeTitle}
            loading="lazy"
            allowfullscreen
            class="h-full w-full"
          />
        </div>
      </section>
    )
  }

  <div class="grid gap-1 pt-1 md:grid-cols-2">
    {
      sections.map((section) => (
        <a href={section.href} class="reveal group relative block overflow-hidden">
          <Image
            src={section.photo.image}
            alt={section.photo.alt[locale]}
            widths={[600, 900, 1400]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover object-[50%_25%] transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-black/25 transition-colors duration-500 group-hover:bg-black/40" />
          <div class="absolute inset-0 flex items-center justify-center p-6">
            <h2 class="text-center text-2xl text-white drop-shadow-md md:text-3xl">
              {section.title}
              <span class="mx-auto mt-4 block h-px w-16 bg-white/80" />
            </h2>
          </div>
        </a>
      ))
    }
  </div>
</Base>
