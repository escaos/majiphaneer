---
import { Image } from 'astro:assets';
import { getContent, type Locale, t } from '@majiphaneer/data';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { personJsonLd } from '../lib/jsonld.ts';
import { pagePath } from '../lib/paths.ts';
import { photoById } from '../lib/photos.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, contravia, books, contact } = getContent(locale);
const hero = photoById('suit-seated');
const aboutPortrait = photoById('floor-thoughtful');
const origin = (Astro.site ?? new URL('http://localhost:4321')).origin;

const cards = [
  {
    href: pagePath(locale, 'contravia'),
    title: t(locale, 'nav.contravia'),
    text: contravia.tagline,
    icon: 'mic',
  },
  {
    href: pagePath(locale, 'books'),
    title: t(locale, 'nav.books'),
    text: books.book.tagline,
    icon: 'book',
  },
  {
    href: pagePath(locale, 'contact'),
    title: contact.invitationsTitle,
    text: contact.invitationsTagline,
    icon: 'users',
  },
] as const;
---

<Base locale={locale} page="home" jsonLd={[personJsonLd(origin, locale)]}>
  <section class="mx-auto grid max-w-5xl items-center gap-10 px-4 pt-12 md:grid-cols-2">
    <div>
      <h1 class="text-4xl leading-tight md:text-[2.75rem]">{home.heroTitle}</h1>
      {home.heroIntro.map((paragraph) => <p class="mt-5 text-lg text-muted">{paragraph}</p>)}
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#story"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
        >
          {t(locale, 'cta.story')}
          <Icon name="arrowRight" size={16} />
        </a>
        <a
          href={pagePath(locale, 'books')}
          class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-2.5 text-sm font-medium transition-colors hover:bg-surface"
        >
          {t(locale, 'cta.book')}
        </a>
        <a
          href={pagePath(locale, 'contravia')}
          class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-2.5 text-sm font-medium transition-colors hover:bg-surface"
        >
          {t(locale, 'cta.podcast')}
        </a>
      </div>
    </div>
    <Image
      src={hero.image}
      alt={hero.alt[locale]}
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="h-auto w-full rounded-xl"
    />
  </section>

  <section class="mx-auto max-w-5xl px-4 pt-16">
    <div class="rounded-xl bg-highlight px-6 py-10 sm:px-10">
      <h2 class="text-2xl">{home.welcomeTitle}</h2>
      {home.welcome.map((paragraph) => <p class="mt-4 max-w-3xl text-muted">{paragraph}</p>)}
    </div>
  </section>

  <section id="about" class="mx-auto grid max-w-5xl gap-10 px-4 pt-16 md:grid-cols-[3fr_2fr]">
    <div>
      <h2 class="text-3xl">{home.aboutTitle}</h2>
      {home.aboutIntro.map((paragraph) => <p class="mt-5 text-muted">{paragraph}</p>)}
    </div>
    <Image
      src={aboutPortrait.image}
      alt={aboutPortrait.alt[locale]}
      widths={[480, 800]}
      sizes="(min-width: 768px) 40vw, 100vw"
      loading="lazy"
      class="h-auto w-full self-start rounded-xl"
    />
  </section>

  <section id="story" class="mx-auto max-w-5xl scroll-mt-8 px-4 pt-16">
    <div class="rounded-xl bg-soft px-6 py-10 sm:px-10">
      <h2 class="text-3xl">{home.storyTitle}</h2>
      {home.story.map((paragraph) => <p class="mt-5 max-w-3xl text-ink/80">{paragraph}</p>)}
    </div>
  </section>

  {
    home.media.length > 0 && (
      <section id="media" class="mx-auto max-w-5xl px-4 pt-16">
        <h2 class="text-3xl">{home.mediaTitle}</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {home.media.map((item) => (
            <li class="rounded-xl border border-border p-5">
              <p class="text-sm uppercase tracking-wide text-muted">{item.outlet}</p>
              <p class="mt-1">{item.title}</p>
              <a href={item.url} rel="noopener" class="mt-2 inline-block text-sm text-secondary">
                {t(locale, 'media.view')}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mx-auto grid max-w-5xl gap-4 px-4 pt-16 sm:grid-cols-3">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="group rounded-xl bg-surface p-6 transition-colors hover:bg-soft"
        >
          <Icon name={card.icon} size={22} class="text-secondary" />
          <h2 class="mt-3 text-lg">{card.title}</h2>
          <p class="mt-2 text-sm text-ink/70">{card.text}</p>
        </a>
      ))
    }
  </section>
</Base>
