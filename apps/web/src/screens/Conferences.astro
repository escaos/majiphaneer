---
import { Image } from 'astro:assets';
import { getContent, type Locale, t } from '@majiphaneer/data';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { pagePath } from '../lib/paths.ts';
import { photoById } from '../lib/photos.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { conferences } = getContent(locale);
const portrait = photoById('suit-standing');
---

<Base locale={locale} page="conferences">
  <section class="mx-auto grid max-w-5xl gap-10 px-4 pt-12 md:grid-cols-[3fr_2fr]">
    <div>
      <h1 class="text-4xl">{conferences.title}</h1>
      <p class="mt-4 font-display text-2xl text-secondary">{conferences.tagline}</p>
      {conferences.description.map((paragraph) => <p class="mt-5 text-muted">{paragraph}</p>)}
      <ul class="mt-8 flex flex-wrap gap-2">
        {
          conferences.topics.map((topic) => (
            <li class="rounded-full bg-surface px-4 py-1.5 text-sm">{topic}</li>
          ))
        }
      </ul>
      <a
        href={pagePath(locale, 'contact')}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-2.5 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
      >
        {t(locale, 'cta.invite')}
        <Icon name="arrowRight" size={16} />
      </a>
    </div>
    <Image
      src={portrait.image}
      alt={portrait.alt[locale]}
      widths={[480, 800]}
      sizes="(min-width: 768px) 40vw, 100vw"
      loading="eager"
      class="h-auto w-full self-start rounded-xl"
    />
  </section>
</Base>
