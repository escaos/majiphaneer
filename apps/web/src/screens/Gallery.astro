---
import { Image } from 'astro:assets';
import { getContent, type Locale } from '@majiphaneer/data';
import Base from '../layouts/Base.astro';
import { RESOLVED_PHOTOS } from '../lib/photos.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { gallery } = getContent(locale);
---

<Base locale={locale} page="gallery">
  <section class="mx-auto max-w-5xl px-4 pt-12">
    <h1 class="reveal text-[clamp(2.75rem,7vw,5rem)] leading-[0.95]">{gallery.title}</h1>
    <p class="reveal reveal-d1 mt-4 max-w-2xl font-serif text-lg italic text-muted">
      {gallery.intro}
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        RESOLVED_PHOTOS.map((photo) => (
          <li class="gallery-item">
            <Image
              src={photo.image}
              alt={photo.alt[locale]}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="aspect-[3/2] w-full rounded-2xl object-cover object-[50%_25%]"
            />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
