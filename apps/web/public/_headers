# Hashed build assets never change — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Belt-and-suspenders with the host-guarded robots.txt: the workers.dev
# fallback host must never be indexed.
https://majiphaneer.workers.dev/*
  X-Robots-Tag: noindex
https://*.workers.dev/*
  X-Robots-Tag: noindex
